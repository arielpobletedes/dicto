# Copia este archivo a apps/web/.env.local (o raíz .env) y completa los valores.

# URL de la aplicación (usado por Better Auth para redirecciones y callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Conexión a la base de datos PostgreSQL en Neon (Fase 1)
# Ejemplo: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=

# Secreto para firma de sesiones y tokens en Better Auth (Fase 2)
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-protouchtyping-change-in-production

# Entorno de ejecución
NODE_ENV=development
